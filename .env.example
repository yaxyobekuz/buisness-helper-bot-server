# ---------- Server ----------
NODE_ENV=development
PORT=4000

# Admin panel manzili (CORS). Bir nechtasi vergul bilan: http://localhost:3000,https://admin.example.com
CORS_ORIGIN=http://localhost:3000

# ---------- MongoDB ----------
MONGODB_URI=mongodb://127.0.0.1:27017/tadbirkorga_komak

# ---------- Telegram bot ----------
# @BotFather dan olinadi
BOT_TOKEN=

# polling | webhook
BOT_MODE=polling

# BOT_MODE=webhook bo'lganda majburiy (https bo'lishi shart)
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/telegram/webhook
# Telegram so'rovlarini tasdiqlash uchun maxfiy kalit — webhook rejimida MAJBURIY.
# Faqat A-Z a-z 0-9 _ - belgilari, 1-256 ta. Masalan: openssl rand -hex 32
WEBHOOK_SECRET=

# O'zi joylashtirilgan Bot API serveri (ixtiyoriy, bo'sh bo'lsa rasmiy API ishlatiladi)
TELEGRAM_API_ROOT=

# ---------- Admin panel ----------
# Birinchi ishga tushishda shu ma'lumotlar bilan admin yaratiladi.
# Keyin profil bo'limidan o'zgartiriladi.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

# Sessiya tokenini imzolash kaliti. Masalan: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Vergul bilan ajratilgan admin telegram ID lari
ADMIN_IDS=
